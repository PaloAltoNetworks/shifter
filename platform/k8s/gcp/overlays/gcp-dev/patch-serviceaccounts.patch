apiVersion: v1
kind: ServiceAccount
metadata:
  name: portal
  namespace: shifter-platform
  annotations:
    iam.gke.io/gcp-service-account: shiftergcpdev-portal@shifter-gcp-dev.iam.gserviceaccount.com
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: workers
  namespace: shifter-platform
  annotations:
    iam.gke.io/gcp-service-account: shiftergcpdev-workers@shifter-gcp-dev.iam.gserviceaccount.com
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ctf-scheduler
  namespace: shifter-platform
  annotations:
    iam.gke.io/gcp-service-account: shiftergcpdev-ctf-scheduler@shifter-gcp-dev.iam.gserviceaccount.com
---
apiVersion: v1
kind: ServiceAccount
metadata:
  # account_id is shortened to "prov-launcher" (GCP 30-char SA id cap; see
  # modules/portal/iam workload_account_id_suffix). Without this annotation the
  # provisioner-launcher KSA has no Workload Identity mapping, so the pod cannot
  # impersonate its GSA and every Secret Manager fetch 403s.
  name: provisioner-launcher
  namespace: shifter-platform
  annotations:
    iam.gke.io/gcp-service-account: shiftergcpdev-prov-launcher@shifter-gcp-dev.iam.gserviceaccount.com
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: provisioner
  namespace: shifter-jobs
  annotations:
    iam.gke.io/gcp-service-account: shiftergcpdev-provisioner@shifter-gcp-dev.iam.gserviceaccount.com
