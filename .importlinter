[importlinter]
root_packages =
    cms
    engine
    management
    mission_control
    shared
    ctf
    config
    workspaces
include_external_packages = True

[importlinter:contract:engine-forbidden]
name = Engine may not depend on CMS, Mission Control, or CTF
type = forbidden
source_modules =
    engine
forbidden_modules =
    cms
    mission_control
    ctf
allow_indirect_imports = True

[importlinter:contract:cms-forbidden]
name = CMS may not depend on Mission Control or CTF
type = forbidden
source_modules =
    cms
forbidden_modules =
    mission_control
    ctf
allow_indirect_imports = True

# ADR-046: the tenancy domain owns Organization/Workspace/WorkspaceMembership and
# authorizes from an already-authenticated Django user. It must not depend on any
# other product domain; consumers depend on it, never the reverse.
[importlinter:contract:workspaces-forbidden]
name = Workspaces stays isolated from other app layers
type = forbidden
source_modules =
    workspaces
forbidden_modules =
    engine
    cms
    mission_control
    ctf
    management
allow_indirect_imports = True

[importlinter:contract:management-forbidden]
name = Management stays isolated from other app layers
type = forbidden
source_modules =
    management
forbidden_modules =
    engine
    cms
    mission_control
    ctf
allow_indirect_imports = True

[importlinter:contract:mission-control-forbidden]
# ADR-001-R4: mission_control intentionally consumes both cms.services and
# engine.services (the engine seam narrowed to a per-symbol allowlist). The
# canonical allowlist is enumerated in scripts/check_layer_imports/layer_imports.yaml;
# this complementary contract prevents a direct CTF dependency.
name = Mission Control may not depend on CTF directly
type = forbidden
source_modules =
    mission_control
forbidden_modules =
    ctf
allow_indirect_imports = True

[importlinter:contract:ctf-forbidden]
name = CTF may not depend on Engine or Mission Control directly
type = forbidden
source_modules =
    ctf
forbidden_modules =
    engine
    mission_control
allow_indirect_imports = True

# ADR-001 (#1523): config is the composition root. It wires public domain
# service facades but must never import domain models directly.
[importlinter:contract:config-forbidden-domain-models]
name = Config (composition root) may not import domain models
type = forbidden
source_modules =
    config
forbidden_modules =
    cms.models
    engine.models
    management.models
    mission_control.models
    ctf.models
    workspaces.models
allow_indirect_imports = True

# ADR-031-R1: the RAES module family supplied by the raes distribution may be
# imported only within shared.raes. The realization layers must consume RAES provisioning through the
# neutral ProvisioningSpec and shared seams, never by importing those modules.
# shared is intentionally excluded as a source module here because
# shared.raes (the manifest builder and RuntimeTarget backend) is the one place
# allowed to import the tooling; shared.raes.__init__ is inert so importing a
# runtime-safe shared.raes submodule never pulls the tooling in transitively.
[importlinter:contract:raes-confined-to-shared-raes]
name = RAES module family is confined to shared.raes (ADR-031-R1)
type = forbidden
source_modules =
    cms
    engine
    management
    mission_control
    ctf
    config
forbidden_modules =
    raes
    raes_contracts
    raes_runtime
    raes_processor
    raes_conformance
    raes_backend_protocols
allow_indirect_imports = True
