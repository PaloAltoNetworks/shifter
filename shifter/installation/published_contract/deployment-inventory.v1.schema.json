{
  "$defs": {
    "DeploymentConfig": {
      "additionalProperties": false,
      "description": "Deployment-level settings shared by every backend.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "profile": {
          "default": "prod",
          "title": "Profile",
          "type": "string"
        }
      },
      "required": [
        "name",
        "domain"
      ],
      "title": "DeploymentConfig",
      "type": "object"
    },
    "ExecutionContext": {
      "additionalProperties": false,
      "description": "One exact Environment, branch and supported workflow tuple.",
      "properties": {
        "environment": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$",
          "title": "Environment",
          "type": "string"
        },
        "ref": {
          "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9_/-]{0,150}$",
          "title": "Ref",
          "type": "string"
        },
        "workflow": {
          "pattern": "^[a-z][a-z0-9_-]*\\.yml$",
          "title": "Workflow",
          "type": "string"
        },
        "reusable_workflow": {
          "anyOf": [
            {
              "pattern": "^Brad-Edwards/shifter/\\.github/workflows/_[a-z0-9_-]+\\.yml@[a-f0-9]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reusable Workflow"
        }
      },
      "required": [
        "environment",
        "ref",
        "workflow"
      ],
      "title": "ExecutionContext",
      "type": "object"
    },
    "ExecutionRepository": {
      "additionalProperties": false,
      "description": "Private execution authority identified by immutable GitHub IDs.",
      "properties": {
        "repository": {
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+$",
          "title": "Repository",
          "type": "string"
        },
        "repository_id": {
          "pattern": "^[1-9][0-9]{0,19}$",
          "title": "Repository Id",
          "type": "string"
        },
        "owner_id": {
          "pattern": "^[1-9][0-9]{0,19}$",
          "title": "Owner Id",
          "type": "string"
        },
        "subject_format": {
          "enum": [
            "default",
            "immutable"
          ],
          "title": "Subject Format",
          "type": "string"
        },
        "purposes": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/ExecutionContext"
            },
            "type": "array"
          },
          "maxProperties": 6,
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "build",
              "validate",
              "promote",
              "release_scan",
              "deploy",
              "destroy"
            ]
          },
          "title": "Purposes",
          "type": "object"
        }
      },
      "required": [
        "repository",
        "repository_id",
        "owner_id",
        "subject_format",
        "purposes"
      ],
      "title": "ExecutionRepository",
      "type": "object"
    },
    "GcpIdentityInputs": {
      "additionalProperties": false,
      "description": "Resource names and bounded capabilities within the deployment project.",
      "properties": {
        "name_prefix": {
          "pattern": "^[a-z][a-z0-9-]{2,21}[a-z0-9]$",
          "title": "Name Prefix",
          "type": "string"
        },
        "evidence_bucket": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$",
          "title": "Evidence Bucket",
          "type": "string"
        },
        "runner_zone": {
          "pattern": "^[a-z]+-[a-z]+[0-9]-[a-z]$",
          "title": "Runner Zone",
          "type": "string"
        },
        "build_read_bucket_names": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Build Read Bucket Names",
          "type": "array"
        },
        "platform_external_bucket_names": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Platform External Bucket Names",
          "type": "array"
        },
        "promotion_reader_service_account_email": {
          "default": "",
          "pattern": "^(?:|[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9]\\.iam\\.gserviceaccount\\.com)$",
          "title": "Promotion Reader Service Account Email",
          "type": "string"
        }
      },
      "required": [
        "name_prefix",
        "evidence_bucket",
        "runner_zone"
      ],
      "title": "GcpIdentityInputs",
      "type": "object"
    },
    "ProductRevision": {
      "additionalProperties": false,
      "description": "Canonical product repository pinned to an immutable commit.",
      "properties": {
        "repository": {
          "const": "Brad-Edwards/shifter",
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "revision"
      ],
      "title": "ProductRevision",
      "type": "object"
    },
    "RootConfig": {
      "additionalProperties": false,
      "description": "The authoritative root installation configuration loaded from ``shifter.yaml``.",
      "properties": {
        "version": {
          "default": 1,
          "title": "Version",
          "type": "integer"
        },
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "deployment": {
          "$ref": "#/$defs/DeploymentConfig"
        },
        "secrets": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Secrets",
          "type": "object"
        },
        "settings": {
          "additionalProperties": true,
          "title": "Settings",
          "type": "object"
        }
      },
      "required": [
        "backend",
        "deployment"
      ],
      "title": "RootConfig",
      "type": "object"
    },
    "SecretReference": {
      "additionalProperties": false,
      "description": "Scoped secret locator without a secret value.",
      "properties": {
        "store": {
          "enum": [
            "gcp-secret-manager",
            "aws-secrets-manager",
            "github-environment"
          ],
          "title": "Store",
          "type": "string"
        },
        "resource": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Resource",
          "type": "string"
        },
        "repository": {
          "anyOf": [
            {
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository"
        },
        "environment": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Environment"
        }
      },
      "required": [
        "store",
        "resource"
      ],
      "title": "SecretReference",
      "type": "object"
    },
    "StateReference": {
      "additionalProperties": false,
      "description": "Dedicated remote state bucket and prefix for one stack.",
      "properties": {
        "bucket": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$",
          "title": "Bucket",
          "type": "string"
        },
        "prefix": {
          "pattern": "^[a-z0-9][a-z0-9_/-]{0,180}[a-z0-9]$",
          "title": "Prefix",
          "type": "string"
        }
      },
      "required": [
        "bucket",
        "prefix"
      ],
      "title": "StateReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned deployment, execution, state and secret-reference contract.",
  "properties": {
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    },
    "installation": {
      "$ref": "#/$defs/RootConfig"
    },
    "product": {
      "$ref": "#/$defs/ProductRevision"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionRepository"
    },
    "state": {
      "additionalProperties": {
        "$ref": "#/$defs/StateReference"
      },
      "propertyNames": {
        "enum": [
          "identity",
          "runner",
          "platform"
        ]
      },
      "title": "State",
      "type": "object"
    },
    "secrets": {
      "patternProperties": {
        "^[A-Z][A-Z0-9_]{0,99}$": {
          "$ref": "#/$defs/SecretReference"
        }
      },
      "title": "Secrets",
      "type": "object"
    },
    "gcp": {
      "anyOf": [
        {
          "$ref": "#/$defs/GcpIdentityInputs"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "version",
    "installation",
    "product",
    "execution",
    "state",
    "secrets"
  ],
  "title": "DeploymentRecord",
  "type": "object"
}
