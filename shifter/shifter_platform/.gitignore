static/spa/

# Frontend workspace generated artifacts. The committed contract is
# frontend/src/api/schema.d.ts (regenerate with `npm run gen:api`); the
# intermediate OpenAPI JSON and test/build outputs are not committed.
frontend/openapi.json
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/dist/
