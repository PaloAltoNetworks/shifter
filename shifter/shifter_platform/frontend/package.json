{
  "name": "shifter-spa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shifter portal single-page application (ADR-029).",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.mermaid.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test e2e/journeys",
    "test:e2e:a11y": "playwright test e2e/a11y",
    "gen:api": "cd .. && TESTING=1 TEST_DB_BACKEND=sqlite uv run python manage.py api_contract && cd frontend && openapi-typescript ../openapi/v1.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.62.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "mermaid": "^10.9.6",
    "radix-ui": "^1.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "js-yaml": "^4.3.0",
    "uuid": "^11.1.1",
    "@redocly/openapi-core": {
      "minimatch": "^10.2.6"
    },
    "eslint": {
      "minimatch": "^10.2.6"
    },
    "@eslint/config-array": {
      "minimatch": "^10.2.6"
    },
    "@eslint/eslintrc": {
      "minimatch": "^10.2.6"
    },
    "eslint-plugin-react": {
      "minimatch": "^10.2.6"
    }
  }
}
