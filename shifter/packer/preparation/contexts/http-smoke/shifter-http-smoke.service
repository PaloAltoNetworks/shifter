[Unit]
Description=Shifter artifact preparation HTTP specimen
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /opt/shifter-http-smoke/server.py --port 8080
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=
Restart=on-failure

[Install]
WantedBy=multi-user.target
