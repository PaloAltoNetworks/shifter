{
  "name": "shifter-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/static/js/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^https://www\\.gstatic\\.com/firebasejs/[^/]+/firebase-app\\.js$": "<rootDir>/static/js/__mocks__/firebase-app.js",
      "^https://www\\.gstatic\\.com/firebasejs/[^/]+/firebase-auth\\.js$": "<rootDir>/static/js/__mocks__/firebase-auth.js"
    },
    "collectCoverageFrom": [
      "static/js/**/*.js",
      "!**/*.test.js",
      "!static/js/__mocks__/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura"
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "@eslint/js": "^10.0.1",
    "babel-jest": "^30.5.1",
    "eslint": "^10.10.0",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
